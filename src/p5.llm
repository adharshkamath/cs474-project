; Define AC line
:extrafuns ((ac Line))
:assumption (on a ac)
:assumption (on c ac)

; Establish points A, B, E are collinear
; Already given in the premise that they're on line AB

; Establish B, C, D are collinear with B-C-D
; Already given in the premise

; Establish a circle with center C that passes through B and D
:extrafuns ((circ_c Circle))
:assumption (center c circ_c)
:assumption (onc b circ_c)
:assumption (onc d circ_c)
; This follows from the given BC = CD

; Establish the angle properties needed for congruence
:assumption (= (angle a c b) (angle d c e))
; Vertical angles are equal

; The key angle that helps establish congruence
:assumption (= (angle c a b) (angle c d e))
; Both equal to rightangle/3 as given or inferred

; Establish the supplementary angle relationship
:assumption (not (on c ab))
:assumption (not (on c de))
:assumption (not (= (angle a c b) 0.0))
:assumption (not (= (angle d c e) 0.0))

; By angle-side-angle congruence
:assumption (= (angle a c b) (angle d c e))
:assumption (= (seg c b) (seg c d))
:assumption (= (angle c a b) (angle c d e))

; Therefore, triangles ABC and CDE are congruent
:assumption (= (seg a c) (seg d e))

; This is our conclusion
:formula (= (seg d e) (seg a c))