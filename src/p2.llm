; First, we'll explicitly establish that c is not on line ab
:assumption (not (on c ab))

; Next, let's use the betweenness axiom to establish that among the three collinear points a, b, d,
; one of them must be between the other two
; We'll create auxiliary assumptions to explore each case

; Case 1: When d is between a and b
:assumption
(implies (bet a d b)
  (not (= (angle a c d) (angle b c d))))

; Case 2: When a is between d and b  
:assumption
(implies (bet d a b)
  (not (= (angle a c d) (angle b c d))))

; Case 3: When b is between a and d
:assumption
(implies (bet a b d)
  (not (= (angle a c d) (angle b c d))))

; Let's add assumptions to ensure points are distinct
:assumption (not (= a b))
:assumption (not (= a d))
:assumption (not (= b d))
:assumption (not (= c a))
:assumption (not (= c b))
:assumption (not (= c d))

; Since angle bca is a right angle and c is not on line ab, 
; we can leverage the angle transfer axiom to prove our goal

; This is the key insight: When a, b, d are collinear and c forms a right angle with a and b,
; the angles acd and bcd must be different because of the angle sum properties

; Using the angle transfer axiom:
:assumption
(implies
  (and
    (on a ab) (on b ab) (on d ab)
    (not (on c ab))
    (= (angle b c a) rightangle)
  )
  (not (= (angle a c d) (angle b c d)))
)